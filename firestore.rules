rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('isAdmin', false) == true
        || get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'admin'
      );
    }

    match /users/{userId} {
      allow read: if ownsUser(userId) || isAdmin();
      allow create: if ownsUser(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'isPro', 'successfulReferralsCount',
          'subscriptionStatus', 'hasUsedTrial', 'has_used_trial_v1', 'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.isPro == false
        && request.resource.data.successfulReferralsCount == 0;
      allow update: if (
          ownsUser(userId)
          && request.resource.data.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoUrl', 'locale'])
        ) || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isPro', 'subscriptionStatus', 'subscriptionPlan', 'proExpiryDate',
            'adminGrantedPro', 'adminGrantedBy', 'adminGrantedAt'
          ])
          && request.resource.data.isPro is bool
          && request.resource.data.subscriptionStatus in ['free', 'pro', 'active', 'trial']
          && (!('subscriptionPlan' in request.resource.data)
            || request.resource.data.subscriptionPlan is string)
          && (!('proExpiryDate' in request.resource.data)
            || request.resource.data.proExpiryDate is timestamp)
          && (!('adminGrantedPro' in request.resource.data)
            || request.resource.data.adminGrantedPro is bool)
        );
      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if ownsUser(userId);
    }

    match /tickets/{ticketId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.ticketId == ticketId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'OPEN'
        && request.resource.data.keys().hasOnly([
          'ticketId', 'userId', 'userEmail', 'category', 'subject',
          'description', 'status', 'deviceInfo', 'createdAt', 'updatedAt',
          'imageUrl'
        ]);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminResponse', 'status', 'updatedAt'
        ])
        && request.resource.data.adminResponse is string
        && request.resource.data.status in [
          'OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'
        ]
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() || (signedIn()
        && (resource.data.referrerId == request.auth.uid
          || resource.data.referredUserId == request.auth.uid));
      allow create, update, delete: if false;
    }

    match /referral_codes/{code} {
      allow read, write: if false;
    }

    match /used_devices/{deviceId} {
      allow read, write: if false;
    }

    match /trial_registrations/{registrationId} {
      allow read, write: if false;
    }
  }
}