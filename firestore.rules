rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if ownsUser(userId);
      allow create: if ownsUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.isPro == false
        && request.resource.data.successfulReferralsCount == 0;
      allow update: if ownsUser(userId)
        && request.resource.data.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'locale']);
      allow delete: if false;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if ownsUser(userId);
    }

    match /referrals/{referralId} {
      allow read: if signedIn()
        && (resource.data.referrerId == request.auth.uid
          || resource.data.referredUserId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /referral_codes/{code} {
      allow read, write: if false;
    }

    match /used_devices/{deviceId} {
      allow read, write: if false;
    }

    match /trial_registrations/{registrationId} {
      allow read, write: if false;
    }
  }
}